# Copie para .env e gere valores próprios. O .env está no .gitignore.
#
#   cp .env.example .env
#   printf 'EDGE_ORIGIN_SECRET=%s\n' "$(openssl rand -hex 32)" >> .env
#
# Nenhum destes valores pode ser versionado. O que está aqui é exemplo de
# FORMATO, e qualquer segredo colado neste arquivo deve ser considerado público.

# Segredo que a borda envia à origem nas rotas protegidas.
EDGE_ORIGIN_SECRET=troque-por-openssl-rand-hex-32

# Chaves de assinatura, no formato "id:segredo,id:segredo".
# Duas ao mesmo tempo é o que permite rotacionar: a nova assina, a antiga
# continua sendo aceita até o token mais longo em circulação expirar.
EDGE_SIGNING_KEYS=k1:troque-por-outro-openssl-rand-hex-32,k2:troque-por-mais-um-openssl-rand-hex-32

# Qual das chaves assina agora.
EDGE_ACTIVE_KEY=k2

# TTL que a origem anuncia e que a borda respeita.
EDGE_CACHE_TTL=60s

# Rate limit por IP na borda. O padrão é alto para não virar o gargalo das
# medições; baixe para 50r/s e burst 10 se quiser ver o 429 acontecendo.
EDGE_RATE_LIMIT=20000r/s
EDGE_RATE_BURST=10000
